# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dota2_tournament?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-here"
# Dev credentials login is enabled by default in development.
# Set to "false" to disable it.
ENABLE_DEV_LOGIN="true"

# ─── OAuth Providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Axiom (Logging) ───────────────────────────────────────────────────────────
# Create a dataset and API token at https://app.axiom.co
NEXT_PUBLIC_AXIOM_DATASET="your-dataset-name"
NEXT_PUBLIC_AXIOM_TOKEN="your-axiom-api-token"
